{
  "name": "tianting-web",
  "version": "0.1.0",
  "private": true,
  "description": "天听 H5 客户端（React），UI 参考微信的信息架构，使用天听自有品牌",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run gen:tokens && tsc -b && vite build",
    "preview": "vite preview",
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node scripts/gen-tokens.mjs --check && node scripts/check-contrast.mjs && node scripts/check-colors.mjs && node scripts/check-brand.mjs src index.html public"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@tianting/sdk": "file:../tianting-sdk-ts",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
